# FlameAtlas Environment Variables
# Copy to .env and insert your real keys

# OpenAI API Key (Never exposed to frontend code)
OPENAI_API_KEY=

# OpenAI Model (defaults to gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini

# NASA API Key (defaults to DEMO_KEY if blank)
NASA_API_KEY=DEMO_KEY

# Local Server Port (default: 3000)
PORT=3000
